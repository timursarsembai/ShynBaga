POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://shynbaga:change-me@127.0.0.1:5436/shynbaga
# Only for tests; the suite wipes this database.
TEST_DATABASE_URL=postgresql://shynbaga:change-me@127.0.0.1:5436/shynbaga_test
# Own residential proxies, comma-separated: http://user:pass@host:port,http://...
# One crawl worker per proxy, all in parallel. Empty means a direct connection.
SHYNBAGA_PROXY_URLS=
# Backup proxies, used only while a worker's own proxy has a broken connection.
SHYNBAGA_BACKUP_PROXY_URLS=
# Seconds between requests of one worker. Kaspi's robots.txt asks for Crawl-delay: 10
# for the whole crawler, so with two workers 20 keeps the total at one per 10 s.
SHYNBAGA_REQUEST_DELAY=20
# Telegram alerts about blocked or failed runs. Empty means alerts only go to the log.
SHYNBAGA_TELEGRAM_BOT_TOKEN=
SHYNBAGA_TELEGRAM_CHAT_ID=
# Admin site. Read-only database role, created once:
#   CREATE ROLE shynbaga_web LOGIN PASSWORD '...'; then shynbaga migrate grants SELECT.
SHYNBAGA_WEB_DB_PASSWORD=
SHYNBAGA_WEB_USER=admin
# read -rs PW; printf '%s\n' "$PW" | shynbaga hash-password
SHYNBAGA_WEB_PASSWORD_HASH=
# Signs session cookies: openssl rand -hex 32
SHYNBAGA_WEB_SECRET=
