POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://shynbaga:change-me@127.0.0.1:5436/shynbaga
# Only for tests; the suite wipes this database.
TEST_DATABASE_URL=postgresql://shynbaga:change-me@127.0.0.1:5436/shynbaga_test
# Residential proxy, e.g. http://user:pass@host:port. Empty means a direct connection.
SHYNBAGA_PROXY_URL=
# Seconds between requests. Kaspi's robots.txt is reported to ask for Crawl-delay: 10.
SHYNBAGA_REQUEST_DELAY=10
# Telegram alerts about blocked or failed runs. Empty means alerts only go to the log.
SHYNBAGA_TELEGRAM_BOT_TOKEN=
SHYNBAGA_TELEGRAM_CHAT_ID=
